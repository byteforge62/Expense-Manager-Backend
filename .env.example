PORT=3001
NODE_ENV=development

JWT_SECRET=
REFRESH_SECRET=

MONGO_URI=
MONGO_URI_TEST=

BREVO_USER=
BREVO_PASS=
# Dedicated Brevo SMTP key (Brevo -> SMTP & API -> SMTP keys). Takes precedence
# over BREVO_PASS. A Brevo API key will not authenticate over SMTP.
BREVO_SMTP_KEY=

GEMINI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# --- Optional platform tuning (defaults shown; nothing here is required) ---
LOG_LEVEL=info
SLOW_REQUEST_MS=500
API_RATE_LIMIT=1000
MONGO_SERVER_SELECTION_MS=10000

# Development-only demo workspace. On server start it creates the two demo
# accounts and seeds the normal user's sample ledger. Set to false to skip.
SEED_DEMO_DATA=true

# Background automation. JOBS_ENABLED=false runs the API only.
JOBS_ENABLED=true
JOB_TIMEOUT_MS=60000
JOB_HISTORY_RETENTION_DAYS=30
EVENT_HANDLER_TIMEOUT_MS=10000
EVENT_MAX_ATTEMPTS=5
OUTBOX_INTERVAL_MS=5000
OUTBOX_LEASE_MS=30000
OUTBOX_CONCURRENCY=5
OUTBOX_RETENTION_DAYS=7

BILL_REMINDER_DAYS=3
BUDGET_ALERT_THRESHOLDS=50,75,90,100
LEGACY_LIST_MAX=2000
REPORT_DETAIL_LIMIT=1000
NOTIFICATION_RETENTION_DAYS=90
IDEMPOTENCY_TTL_MS=86400000
SUMMARY_RECONCILE_LOOKBACK_DAYS=2
SUMMARY_RECONCILE_MAX_USERS=200
INTELLIGENCE_REFRESH_BATCH=10
SSE_HEARTBEAT_MS=25000
SSE_MAX_CONNECTIONS=5

# --- Password recovery ---
# Absolute base URL used in reset links. Required in production.
CLIENT_URL=http://localhost:5173
# Verified Brevo sender; defaults to BREVO_USER when unset.
MAIL_FROM=
# Reset link lifetime and per-IP request budget.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=10
